# Copy to .env (or .env.local) and fill in. Never commit the filled-in file.

# MongoDB connection string.
# ALWAYS name the database in the path - without it the driver silently
# falls back to Mongo's default `test` database.
# Local:  mongodb://127.0.0.1:27017/lettersandnumber
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/numbersandletter?retryWrites=true&w=majority
MONGODB_URI=

# Signing key for the session JWT. At least 32 characters; rotating it signs
# everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Credentials for `npm run seed:admin`, which plants the single super admin.
# Only read by that script - the running app never looks at them.
SUPER_ADMIN_EMAIL=
# Leave blank to have a strong password generated and printed once.
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=
SUPER_ADMIN_LAST_NAME=

# Where the app is reachable. Emailed invitation and reset links are built on
# this, so it must be the real public URL in production - never derived from
# the request, which an attacker could spoof via the Host header.
APP_URL=http://localhost:3000

# Outbound email. With SMTP_HOST unset, messages are printed to the server
# console instead of being sent (development only - sending is required in
# production and the app refuses to fake it there).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Letters and Numbers <no-reply@example.com>"
